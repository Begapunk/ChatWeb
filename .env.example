# Aether 环境变量示例（M1 起使用；复制为 .env 填入真实值，切勿提交）
# 所有密钥/密码/Token 仅通过环境变量注入，禁止写入前端与日志/git 历史。
# 本地测试用 .env.test（同样 gitignore；值每轮随机生成）。

# ---- 公共 ----
AETHER_DOMAIN=chat.example.com          # 部署域名（生产入口；本地测试填 localhost 即可）
TZ=Asia/Shanghai
OPERATOR_EMAIL=admin@example.com        # 渲染进 homeserver.yaml 的 admin_contact

# ---- 镜像源（Docker Hub 不可达时经镜像源拉取；digest 记录于部署检查报告）----
REGISTRY_MIRROR=docker.1ms.run
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- PostgreSQL（Synapse 库；邀请服务独立库由 init 脚本另建，Q6）----
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=__CHANGE_ME__         # 强随机（hex/base64url，避免 shell 特殊字符）
# 数据库不暴露任何端口，仅 compose 内网可达（生产/本地两 profile 一致）
INVITE_DB_USER=invite
INVITE_DB_PASSWORD=__CHANGE_ME__        # 邀请服务库专属密码（hex/base64url）
INVITE_DB_NAME=invite
# INVITE_DB_URL 无需手填：compose 会组装为
#   postgresql://${INVITE_DB_USER}:${INVITE_DB_PASSWORD}@postgres:5432/${INVITE_DB_NAME}
# （.env 中仍可显式提供 INVITE_DB_URL 覆盖，用于容器外直连调试）

# ---- Synapse ----
SYNAPSE_SERVER_NAME=chat.example.com    # 不可变更！部署后更换 server_name = 数据迁移
SYNAPSE_REPORT_STATS=no
SYNAPSE_REGISTRATION_SHARED_SECRET=__CHANGE_ME__   # 仅邀请服务自举管理员时使用
SYNAPSE_MACARON_SECRET_KEY=__CHANGE_ME__
SYNAPSE_FORM_SECRET=__CHANGE_ME__
# 注册必须令牌 / 禁访客 / 关联邦：固定在 infra/synapse/homeserver.yaml.template
# public_baseurl 形态由渲染脚本决定：
SYNAPSE_PUBLIC_BASEURL_MODE=production  # production= https://$AETHER_DOMAIN/ ; local= http://127.0.0.1:8008/

# ---- 邀请服务 (FastAPI) ----
INVITE_SERVICE_PORT=8000                # 仅绑定 127.0.0.1（管理 CLI / 测试直连）
SYNAPSE_ADMIN_USERNAME=aether-admin     # 自举创建的 Synapse 管理员（占第 1 席）
SYNAPSE_ADMIN_PASSWORD=__CHANGE_ME__
INVITE_ADMIN_API_KEY=__CHANGE_ME__      # ≥32 字符随机；管理端点 X-Admin-Key
INVITE_HASH_PEPPER=__CHANGE_ME__        # ≥32 字节随机（建议 base64）；参与码哈希
AETHER_MAX_MEMBERS=4
INVITE_CODE_TTL_SECONDS=259200          # 邀请码默认有效期 72h（PRD 默认）
INVITE_MAX_ATTEMPTS=5
INVITE_TOKEN_TTL_MINUTES=60             # 注册令牌短时效
INVITE_POLL_SECONDS=5                   # 新用户轮询入房间隔

# ---- Caddy ----
CADDY_ACME_EMAIL=admin@example.com

# ---- LiveKit / Element Call (M6) ----
LIVEKIT_API_KEY=__CHANGE_ME__
LIVEKIT_API_SECRET=__CHANGE_ME__        # 仅 lk-jwt-service 服务端持有
LIVEKIT_URL=wss://livekit.example.com
ELEMENT_CALL_URL=https://call.example.com

# ---- TURN (M6, 按网络测试启用) ----
TURN_ENABLED=false
TURN_SECRET=__CHANGE_ME__
TURN_REALM=turn.example.com

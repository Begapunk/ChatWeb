# M1 测试环境变量（复制为 m1/.env.test 填真实值；真实值不入 git）
# 缺省时 helpers.mjs 会回退读取仓库根 .env.test（compose 同源，推荐只用根文件）。

# 经 Caddy 的公网入口（本地 profile：自签证书 → 请求走 helpers 内专用 Agent，勿全局关校验）
M1_CADDY_URL=https://127.0.0.1
# 邀请服务直连回环（管理 CLI 通道，PRD Q1(b)）
M1_INVITE_DIRECT_URL=http://127.0.0.1:8000
# Synapse 直连回环（本地 profile 才有；E2EE 的 SDK 客户端走这里，避开自签 TLS）
M1_SYNAPSE_DIRECT_URL=http://127.0.0.1:8008
# = 与根 .env.test 同值 =
M1_ADMIN_KEY=__SAME_AS_INVITE_ADMIN_API_KEY__
M1_SYNAPSE_ADMIN_USERNAME=__SAME_AS_SYNAPSE_ADMIN_USERNAME__
M1_SYNAPSE_ADMIN_PASSWORD=__SAME_AS_SYNAPSE_ADMIN_PASSWORD__

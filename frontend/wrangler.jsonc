{
  "name": "misty-grass-7f92",
  "account_id": "b52217c78219b8425f063fdd895583a2",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONNECTIVITY", "class_name": "ConnectivityRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-connectivity-sqlite", "new_sqlite_classes": ["ConnectivityRoom"] }
  ]
}
